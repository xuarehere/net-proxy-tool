      "desc": "开源 AI 模型权重下载",
      "category": "AI/大模型"
    },
    "PyPI": {
      "url": "https://pypi.org",
      "desc": "Python 官方包索引与依赖",
      "category": "包管理"
    },
    "OpenAI API": {
