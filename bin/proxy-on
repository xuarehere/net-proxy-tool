# Source this file in Bash to update the current session.
source "$(dirname "${BASH_SOURCE[0]}")/python-env.sh" || return 1
_npt_exports=$("$npt_python" "$npt_root/bin/session_env.py") || return 1
if [[ -z ${_npt_active:-} ]]; then
    _npt_restore=""
    for _npt_key in http_proxy HTTP_PROXY https_proxy HTTPS_PROXY all_proxy ALL_PROXY no_proxy NO_PROXY; do
        if [[ -n ${!_npt_key+x} ]]; then
            printf -v _npt_value '%q' "${!_npt_key}"
            if [[ $(declare -p "$_npt_key") =~ ^declare[[:space:]]-[^[:space:]]*x ]]; then
                _npt_restore+="export ${_npt_key}=${_npt_value};"
            else
                _npt_restore+="export -n ${_npt_key}=${_npt_value};"
            fi
        else
            _npt_restore+="unset ${_npt_key};"
        fi
    done
fi
eval "$_npt_exports"
_npt_active=1
unset npt_python npt_root _npt_exports _npt_key _npt_value
