#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 2 ]]; then echo "Usage: docker-proxy {on|off|status|exec} CONTAINER [COMMAND ...]" >&2; exit 2; fi
action=$1
container=$2
shift 2
source "$(dirname "${BASH_SOURCE[0]}")/python-env.sh"
profile=/etc/profile.d/net-proxy.sh
case "$action" in
    exec) exec "$npt_root/bin/with-proxy-docker" "$container" "$@" ;;
    on)
        exports=$("$npt_python" "$npt_root/bin/session_env.py")
        pam=$("$npt_python" "$npt_root/bin/session_env.py" --environment-file)
        {
            "$npt_python" -c 'import shlex,sys; print("action=on"); print("profile_content="+shlex.quote("# Generated by net-proxy-tool\n"+sys.argv[1])); print("environment_content="+shlex.quote(sys.argv[2]))' "$exports" "$pam"
            cat "$npt_root/bin/docker-proxy-state.sh"
        } | docker exec -i -- "$container" sh ;;
    off)
        { printf 'action=off\n'; cat "$npt_root/bin/docker-proxy-state.sh"; } | docker exec -i -- "$container" sh ;;
    status)
        docker exec -- "$container" sh -c '
            if [ -f "$1" ] && grep -qx "# Generated by net-proxy-tool" "$1"; then echo on; else echo off; fi
        ' sh "$profile" ;;
    *) echo "Unknown action: $action" >&2; exit 2 ;;
esac
