#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 2 ]]; then echo "Usage: docker-proxy {on|off|status|exec} CONTAINER [COMMAND ...]" >&2; exit 2; fi
action=$1
container=$2
shift 2
source "$(dirname "${BASH_SOURCE[0]}")/python-env.sh"
profile=/etc/profile.d/net-proxy.sh
case "$action" in
    exec) exec "$npt_root/bin/with-proxy-docker" "$container" "$@" ;;
    on)
        exports=$("$npt_python" "$npt_root/bin/session_env.py")
        pam=$("$npt_python" "$npt_root/bin/session_env.py" --environment-file)
        printf '%s\n%s\n' '# Generated by net-proxy-tool' "$exports" |
            docker exec -i -- "$container" sh -eu -c '
                file=$1
                if [ -e "$file" ] && ! grep -qx "# Generated by net-proxy-tool" "$file"; then
                    echo "Existing profile belongs to another application: $file" >&2
                    exit 1
                fi
                tmp=$(mktemp "$file.XXXXXXXX")
                trap "rm -f -- $tmp" EXIT
                cat > "$tmp"
                chmod 644 "$tmp"
                mv "$tmp" "$file"
            ' sh "$profile"
        printf '%s\n' "$pam" | docker exec -i -- "$container" sh -eu -c '
            file=/etc/environment
            if [ ! -f "$file" ]; then exit 0; fi
            tmp=$(mktemp /tmp/net-proxy-environment.XXXXXXXX)
            trap "rm -f -- $tmp" EXIT
            sed "/ # net-proxy-tool$/d" "$file" > "$tmp"
            cat >> "$tmp"
            cat "$tmp" > "$file"
        ' ;;
    off)
        docker exec -- "$container" sh -eu -c '
            if [ -f "$1" ] && grep -qx "# Generated by net-proxy-tool" "$1"; then rm "$1"; fi
            # Older installations also managed tagged lines in /etc/environment.
            if [ -f /etc/environment ] && grep -q " # net-proxy-tool$" /etc/environment; then
                sed -i "/ # net-proxy-tool$/d" /etc/environment
            fi
        ' sh "$profile" ;;
    status)
        docker exec -- "$container" sh -c '
            if [ -f "$1" ] && grep -qx "# Generated by net-proxy-tool" "$1"; then echo on; else echo off; fi
        ' sh "$profile" ;;
    *) echo "Unknown action: $action" >&2; exit 2 ;;
esac
