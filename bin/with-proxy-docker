#!/usr/bin/env bash
set -e
if [[ $# -lt 2 ]]; then echo "Usage: with-proxy-docker CONTAINER COMMAND [ARG ...]" >&2; exit 2; fi
container=$1
shift
source "$(dirname "${BASH_SOURCE[0]}")/python-env.sh"
exports=$("$npt_python" "$npt_root/bin/session_env.py")
eval "$exports"
tty_flags=()
if [[ -t 0 && -t 1 ]]; then tty_flags=(-it); fi
exec docker exec "${tty_flags[@]}" -e HTTP_PROXY -e HTTPS_PROXY -e http_proxy -e https_proxy \
    -e ALL_PROXY -e all_proxy -e no_proxy -e NO_PROXY -- "$container" "$@"
